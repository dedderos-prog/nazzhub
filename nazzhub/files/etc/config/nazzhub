config settings 'settings'
        option config_version '1.0.5'
        list applied_migrations 'interface_sections'
        list applied_migrations 'enable_component_checks'
        list applied_migrations 'http_connection_urls'
        option dns_type 'doh'
        list dns_server 'dns.nazzhub.org/dns-query'
        list dns_server '8.8.8.8'
        list dns_server 'unfiltered.adguard-dns.com'
        list bootstrap_dns_server '77.88.8.8'
        list bootstrap_dns_server '77.88.8.1'
        option dns_check_interval '10s'
        option dns_recovery_check_interval '60s'
        option dns_check_timeout '2s'
        option dns_rewrite_ttl '60'
        option dns_strategy 'prefer_ipv4'
        option dns_detour_enabled '0'
        #option dns_detour_section 'Main'
        list source_network_interfaces 'br-lan'
        option enable_output_network_interface '0'
        #option output_network_interface 'wan'
        option enable_badwan_interface_monitoring '1'
        list badwan_monitored_interfaces 'wan'
        option badwan_reload_delay '2000'
        option enable_yacd '0'
        option disable_quic '0'
        option exclude_bittorrent '0'
        option list_update_enabled '1'
        option update_interval '1d'
        option component_update_check_enabled '1'
        option component_update_check_interval '1d'
        option latency_test_url 'https://www.gstatic.com/generate_204'
        option download_lists_via_proxy '1'
        option download_components_via_proxy '0'
        option download_lists_via_proxy_section 'Main'
        #option download_components_via_proxy_section 'Main'
        option dont_touch_dhcp '0'
        option config_path '/etc/sing-box/config.json'
        option cache_path '/tmp/sing-box/cache.db'
        option log_level 'warn'
        option exclude_ntp '0'
        option shutdown_correctly '0'

config section 'zapret2'
        option label 'Zapret2'
        option enabled '1'
        option action 'zapret2'
        option nfqws2_opt ''
        list community_lists 'youtube'

config section 'Main'
        option label 'Main'
        option enabled '1'
        option action 'connection'
        list community_lists 'russia_outside'
        list community_lists 'russia_inside'
        list community_lists 'geoblock'
        list community_lists 'meta'
        list community_lists 'twitter'
        list community_lists 'telegram'
        list community_lists 'google_ai'
        list community_lists 'discord'

config subscription_url 'main_sub'
        option section 'Main'
        option url ''
        option auto_user_agent '1'
        option user_agent 'CustomAgent/1.0'
        option auto_hwid '1'
        option subscription_update_enabled '1'
        option subscription_update_interval '1h'
        option download_via_proxy_enabled '0'
        option show_dashboard_metadata '1'
        option prefix_nodes '0'
        option include_urltest_groups '1'
        option hide_urltest_group_outbounds '1'
        option hide_detour_outbounds '1'

config priority_group 'Priority'
        option section 'Main'
        option name 'Priority'
        option health_url 'https://www.gstatic.com/generate_204'
        option active_check_interval '5s'
        option check_timeout '2s'
        option recovery_check_interval '15s'
        option pick_fastest '0'
        option switch_to_faster_same_priority '0'
        option interrupt_exist_connections '1'
        option pin_dashboard '1'

config priority_level 'level_1'
        option group 'Priority'
        option name '1'
        option order '0'
        option direct '0'
        option filter_mode 'disabled'

config section 'xbox_dns_dot'
        option label 'Xbox DNS (DoT)'
        option enabled '1'
        option action 'dns'
        option dns_type 'dot'
        option dns_server 'xbox-dns.ru'
        list community_lists 'google_ai'
        list community_lists 'xbox'
        list community_lists 'playstation'

config section 'xbox_dns_doh'
        option label 'Xbox DNS (DoH)'
        option enabled '0'
        option action 'dns'
        option dns_type 'doh'
        option dns_server 'xbox-dns.ru/dns-query'
        list community_lists 'google_ai'
        list community_lists 'xbox'
        list community_lists 'playstation'
